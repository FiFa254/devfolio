@model PagedList<ProfileProject>

@{
    ViewData["Title"] = "Projects";
}

<section class="page-header">
    <h1>Projects</h1>
    <p>Explore all projects shared by portfolio members.</p>
</section>

@if (Model.TotalCount == 0)
{
    <section class="empty-state">
        <h3>No projects yet</h3>
        <p>Projects appear here when a profile lists them.</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary" asp-action="AddProfile">Add Profile</a>
        }
    </section>
}
else
{
    <div class="card-grid">
        @foreach (var project in Model.Items)
        {
            <partial name="_ProjectCard" model="project" />
        }
    </div>

    <partial name="_Pager" model="@(new PagerModel(Model.Page, Model.TotalPages, "Projects"))" />
}
