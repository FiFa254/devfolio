@model DevFolio.Models.Profile

@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}";
    ViewData["HideOwner"] = true;
}

<p class="back-link">
    <a asp-action="Profiles">&larr; Back to Profiles</a>
</p>

<section class="profile-hero">
    <div class="profile-hero-banner"></div>
    <div class="profile-hero-body">
        <partial name="_Avatar" model="@((Model, "xxl"))" />
        <div class="profile-hero-info">
            <h1>@Model.FirstName @Model.LastName</h1>
            <p class="profile-detail-bio">@(string.IsNullOrWhiteSpace(Model.Bio) ? "No bio provided." : Model.Bio)</p>
        </div>
        <div class="profile-hero-actions">
            <a class="btn btn-primary" asp-action="Contact" asp-route-id="@Model.Id" rel="nofollow">Contact</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="btn btn-outline-secondary" asp-action="EditProfile" asp-route-id="@Model.Id">Edit</a>
                <form asp-action="DeleteProfile" asp-route-id="@Model.Id" method="post"
                      data-confirm="Delete this profile and all of its projects? This cannot be undone.">
                    <button type="submit" class="btn btn-outline-danger">Delete</button>
                </form>
            }
        </div>
    </div>
</section>

<section class="section">
    <div class="section-header">
        <h2>Projects (@Model.Projects.Count)</h2>
    </div>

    @if (!Model.Projects.Any())
    {
        <div class="empty-state">
            <p>No projects listed for this profile.</p>
        </div>
    }
    else
    {
        <div class="card-grid">
            @foreach (var project in Model.Projects)
            {
                <partial name="_ProjectCard" model="project" />
            }
        </div>
    }
</section>
