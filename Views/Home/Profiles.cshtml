@model PagedList<ProfileSummary>

@{
    ViewData["Title"] = "Profiles";
}

<section class="page-header">
    <h1>Profiles</h1>
    <p>Browse all developers in the portfolio showcase.</p>
</section>

@if (Model.TotalCount == 0)
{
    <section class="empty-state">
        <h3>No profiles yet</h3>
        <p>Profiles will appear here once they are added.</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary" asp-action="AddProfile">Add Profile</a>
        }
    </section>
}
else
{
    <div class="card-grid">
        @foreach (var item in Model.Items)
        {
            <partial name="_ProfileCard" model="item" />
        }
    </div>

    <partial name="_Pager" model="@(new PagerModel(Model.Page, Model.TotalPages, "Profiles"))" />
}
