@{
    ViewData["Title"] = "Home";
    var profileCount = (int)(ViewBag.ProfileCount ?? 0);
    var projectCount = (int)(ViewBag.ProjectCount ?? 0);
    var recentProfiles = ViewBag.RecentProfiles as IEnumerable<ProfileSummary> ?? [];
    var recentProjects = ViewBag.RecentProjects as IEnumerable<DevFolio.Models.ProfileProject> ?? [];
    var featured = recentProfiles.FirstOrDefault();
}

<section class="hero">
    <div>
        <h1>Discover talent.<br />Explore projects.</h1>
        <p class="hero-lead">
            A curated space to browse developer profiles and the projects they have built.
            See what each developer has built, with links to the code.
        </p>
        <div class="hero-actions">
            <a class="btn btn-primary" asp-action="Profiles">Browse Profiles</a>
            <a class="btn btn-outline-secondary" asp-action="Projects">View Projects</a>
        </div>
        <p class="hero-meta">@profileCount profiles &middot; @projectCount projects &middot; curated by admin</p>
    </div>

    @if (featured is not null)
    {
        <aside class="hero-feature" aria-label="Latest profile">
            <partial name="_Avatar" model="@((featured.Profile, "xl"))" />
            <h2>@featured.Profile.FirstName @featured.Profile.LastName</h2>
            <p>@(string.IsNullOrWhiteSpace(featured.Profile.Bio) ? "No bio yet." : featured.Profile.Bio)</p>
            <div class="hero-feature-footer">
                <span>@featured.ProjectCount project(s)</span>
                <a class="btn btn-light btn-sm" asp-action="Profile" asp-route-id="@featured.Profile.Id">View profile &rarr;</a>
            </div>
        </aside>
    }
</section>

@if (recentProfiles.Any())
{
    <section class="section">
        <div class="section-header">
            <h2>Latest Profiles</h2>
            <a class="section-link" asp-action="Profiles">View all &rarr;</a>
        </div>
        <div class="card-grid">
            @foreach (var summary in recentProfiles)
            {
                <partial name="_ProfileCard" model="summary" />
            }
        </div>
    </section>
}

@if (recentProjects.Any())
{
    <section class="section">
        <div class="section-header">
            <h2>Recent Projects</h2>
            <a class="section-link" asp-action="Projects">View all &rarr;</a>
        </div>
        <div class="card-grid">
            @foreach (var project in recentProjects)
            {
                <partial name="_ProjectCard" model="project" />
            }
        </div>
    </section>
}

@if (!recentProfiles.Any() && !recentProjects.Any())
{
    <section class="empty-state">
        <h3>No profiles yet</h3>
        <p>Profiles and projects will appear here once they are added.</p>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary" asp-action="AddProfile">Add Profile</a>
        }
    </section>
}
